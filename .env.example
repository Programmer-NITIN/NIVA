# ============================================
# NIVA — Environment Configuration
# Copy to .env and fill in your values
# ============================================

# --- Database ---
POSTGRES_DB=niva
POSTGRES_USER=niva
POSTGRES_PASSWORD=niva_dev_2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://niva:niva_dev_2026@localhost:5432/niva

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Account Aggregator ---
AA_MODE=mock                          # "mock" (RebitMockAAProvider) | "setu" (SetuAAProvider)
SETU_BASE_URL=https://fiu-uat.setu.co
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=

# --- LLM ---
LLM_PROVIDER=gemini                   # "gemini" | "groq"
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Backend ---
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=niva-hackathon-secret-change-in-prod
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AA_MODE=mock
